# Copy this file to .env.local and fill it in. .env.local is never committed.
# For the deployed Worker, the two secrets below are set with
# `npx wrangler secret put <NAME>`; the NEXT_PUBLIC_* values are read from
# .env.local when the app is built.

# ── Supabase: your own project (Project Settings > API) ──────────────────────
# The project's address, like https://<project id>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# The public (anon) key. It is safe in the browser: the database's access rules decide what it can read.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SECRET. The service-role key passes every access rule. Server code and the scripts on your own machine use it.
SUPABASE_SERVICE_ROLE_KEY=

# ── GridPane (Settings > GridPane API) ───────────────────────────────────────
# SECRET. The sync reads servers and sites with it; the app writes PHP settings and backup times with it.
GRIDPANE_API_TOKEN=

# ── Cloudflare Access (optional, recommended) ────────────────────────────────
# When both are set, the app refuses every request that does not carry a valid
# Access token, before its own login page. Set one without the other and it
# refuses everything until both are set. On Workers, set them on the Worker,
# both in one step: bash scripts/set-access-check.sh (never one at a time).
# Set them here only if this machine's copy also sits behind Access: a local
# run with them set refuses every request. Kept out of this file, put the same
# two lines in ~/.config/fleet/privacy-extra, so `npm run privacy:denylist`
# still lists them as private.
# Your team's address, like yourteam.cloudflareaccess.com
CF_ACCESS_TEAM_DOMAIN=
# The application's audience tag (Access > Applications > your app > Overview)
CF_ACCESS_AUD=

# ── Single sign-on to WordPress (optional; off until you turn it on) ─────────
# The user ids allowed to use it, separated by commas. Empty means nobody.
SSO_ALLOWED_USER_IDS=
# SECRETS. Two private keys made for this feature by `bash scripts/sso-make-keys.sh`.
SSO_SIGN_PRIVATE_KEY=
SSO_BOX_PRIVATE_KEY=

# ── Patchstack firewall (optional; it works with no account) ─────────────────
# middleware.ts runs patchstack.next.ts on every request. With none of these set
# it blocks on the rules in patchstack.rules.json and sends Patchstack nothing.
# To connect an account, see SETUP.md, 11e. For the deployed Worker, set them on
# the Worker (the key with `npx wrangler secret put PATCHSTACK_API_KEY`), not here.
# "dry-run" logs what it would block and blocks nothing. Empty means block.
PATCHSTACK_MODE=
# Your Patchstack site's id, used when patchstack.next.ts has none written in.
PATCHSTACK_SITE_UUID=
# SECRET. A Patchstack rules token, used only when there is no site id.
PATCHSTACK_WAF_TOKEN=
# "sandbox" checks for new rules every 15 seconds instead of every 5 minutes.
PATCHSTACK_ENVIRONMENT=
# SECRET. Your site's key, written by `npx @patchstack/connect setup` to the
# git-ignored .patchstackrc.local.json.
PATCHSTACK_API_KEY=
